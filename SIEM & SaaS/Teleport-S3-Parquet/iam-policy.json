{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTeleportParquet",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::YOUR-TELEPORT-EVENTS-BUCKET/events/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-TELEPORT-EVENTS-BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["events/*"]
        }
      }
    },
    {
      "Sid": "DecryptIfKms",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/YOUR-KEY-ID"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "*"
    }
  ]
}
