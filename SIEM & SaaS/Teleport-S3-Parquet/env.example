# Coralogix ? Data Flow ? API Keys ? Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your-coralogix-send-your-data-key

# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, us1.coralogix.com, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com

CORALOGIX_APPLICATION_NAME=teleport
CORALOGIX_SUBSYSTEM_NAME=audit

# Optional. Only process keys under this prefix (Teleport events, not session recordings).
# Examples: events/   or   <tenant-id>/
S3_KEY_PREFIX=events/
S3_KEY_SUFFIX=.parquet

CORALOGIX_BATCH_SIZE=400
CORALOGIX_TIMEOUT_SECONDS=60
CORALOGIX_MAX_RETRIES=4
LOG_LEVEL=INFO

# Set to true to parse parquet without sending
DRY_RUN=false
