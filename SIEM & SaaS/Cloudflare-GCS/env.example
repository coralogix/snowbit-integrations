# Coralogix -> Data Flow -> API Keys -> Send-Your-Data
CORALOGIX_SEND_YOUR_DATA_KEY=your-coralogix-send-your-data-key

# Domain examples: eu1.coralogix.com, eu2.coralogix.com, coralogix.in, us1.coralogix.com, cx498.coralogix.com
CORALOGIX_DOMAIN=eu1.coralogix.com

CORALOGIX_APPLICATION_NAME=cloudflare
CORALOGIX_SUBSYSTEM_NAME=logpush

# Optional. Only process objects under this prefix (Logpush destination path).
# Example: cloudflare/http/
GCS_KEY_PREFIX=
# Optional. Example: .gz  or  .log.gz
GCS_KEY_SUFFIX=.gz

CORALOGIX_BATCH_SIZE=400
CORALOGIX_TIMEOUT_SECONDS=60
CORALOGIX_MAX_RETRIES=4
LOG_LEVEL=INFO

# Set to true to parse files without sending
DRY_RUN=false

# Attach gcs_bucket / gcs_object / cx_source on each log
INCLUDE_SOURCE_METADATA=false
